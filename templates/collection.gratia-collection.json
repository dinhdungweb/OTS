}},"rich_text_XPdfyE":{"type":"rich-text","blocks":{"richtext_KGDUe6":{"type":"richtext","settings":{"content":"<p>Gratia được sinh ra dành cho những trái tim đang đi tìm điểm tựa tinh thần, một vật nhỏ bé nhưng đủ sức gợi nhắc rằng thế giới vẫn ấm áp, và hạnh phúc vẫn sẽ đến với người biết tin vào nó.<br\/><br\/>Mỗi thiết kế, từ viên Garnet đỏ thẫm như trái tim rực cháy, đến Citrine vàng mật như giọt nắng sớm, đều mang năng lượng của  tình yêu thương được chở che, may mắn dịu dàng tìm đến và niềm tin vào những điều tốt lành<br\/><br\/>Có được những thiết kế của Gratia Collection, bạn mang theo bên mình một câu chuyện về tình yêu mà bạn xứng đáng, về điều may mắn mà vũ trụ đang gửi đến bạn theo cách thật lặng lẽ mà bền bỉ.<\/p>"}}},"block_order":["richtext_KGDUe6"],"name":"Rich text","settings":{"full_width":true,"content_width":"small","text_position":"center","background":"","background_gradient":"","text_color":""}},"featured_collection_tyLdMU":{"type":"featured-collection","name":"Featured collection","settings":{"collection":"all-products","products":["aurel-earrings-gratia-ofthesun","aureva-ring-ofthesun","amoria-garnet-pendant-gratia-ofthesun","belova-earrings-gratia-ofthesun","serena-charm-ofthesun"],"full_width":true,"stack_products":true,"show_progress_bar":false,"products_count":5,"products_per_row_mobile":"1","products_per_row_desktop":5,"subheading":"","title":"","content":"","link_url":"","link_text":"","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","product_card_background":"","product_card_text_color":""}},"multi_column_6zQtFy":{"type":"multi-column","name":"Multi-column","settings":{"full_width":true,"stack_on_mobile":true,"gap":"medium","text_alignment":"center","subheading":"About","title":"Featured content","content":"<p>Organize content into multiple columns to share useful information to your customers about your products, values...<\/p>","background":"","background_gradient":"","text_color":""}},"multi_column_cDwUCa":{"type":"multi-column","blocks":{"item_zxQjLk":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/1_8684b551-2444-4dea-a0a4-7f1ac153ea39.jpg","column_size":"3","title":"","heading_tag":"h4","content":"","link_url":"","link_text":"","link_style":"link"}},"item_NzVKbz":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/3_4182729a-5495-4e97-a114-5c339e905024.jpg","column_size":"3","title":"","heading_tag":"h4","content":"","link_url":"","link_text":"","link_style":"link"}},"item_rdxgx4":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/2_66e19ec2-4d52-4f3a-87c0-0035a3a1396d.jpg","column_size":"3","title":"","heading_tag":"h4","content":"","link_url":"","link_text":"","link_style":"link"}}},"block_order":["item_zxQjLk","item_NzVKbz","item_rdxgx4"],"name":"Multi-column","settings":{"full_width":true,"stack_on_mobile":true,"gap":"small","text_alignment":"center","subheading":"","title":"","content":"","background":"","background_gradient":"","text_color":""}},"multi_column_UbmgaB":{"type":"multi-column","blocks":{"item_99B3x6":{"type":"item","settings":{"video":"shopify:\/\/files\/videos\/12.12_Video hành trình lên ý tưởng SP 1x1.mov","column_size":"2","title":"","heading_tag":"h4","content":"","link_url":"","link_text":"","link_style":"link"}},"item_8qJCCB":{"type":"item","settings":{"column_size":"2","title":"LET LUCK COME TO YOU","heading_tag":"h1","content":"<p>Giáng Sinh là mùa của ánh sáng, hy vọng và những phép màu nhỏ bé. Gratia được tạo nên riêng cho mùa lễ này, như một món quà mà vũ trụ thì thầm dành tặng bạn.<br\/><br\/>Một câu chuyện cổ tích nàng tự viết cho chính mình. Không phải phép màu đến từ đâu xa, Gratia là lời nhắc rằng nàng chính là người viết nên điều may mắn trong câu chuyện của mình. Bộ sưu tập được tạo nên để đồng hành cùng những cô gái tin vào yêu thương đẹp và tin vào mình.<br\/><br\/>Vẻ đẹp tinh tế, mềm mại, gợi cảm giác được chở che. Từng đường cong, từng mặt đá đều được chế tác để gợi hình ảnh đôi cánh nhỏ đang bao bọc điều quý giá. Đeo Gratia, bạn như đang giữ bên mình một thần hộ mệnh vừa dịu dàng, vừa linh thiêng.<\/p>","link_url":"","link_text":"","link_style":"link"}}},"block_order":["item_99B3x6","item_8qJCCB"],"name":"Multi-column","settings":{"full_width":true,"stack_on_mobile":true,"gap":"x-large","text_alignment":"start","subheading":"","title":"","content":"","background":"","background_gradient":"","text_color":""}},"multi_column_z3DN4f":{"type":"multi-column","blocks":{"item_D97BzA":{"type":"item","settings":{"column_size":"3","title":"","heading_tag":"h1","content":"<p>Giáng Sinh này, Of The Sun muốn nói với bạn rằng: <br\/>“May mắn không chỉ là điều ta đợi chờ, mà là điều ta lựa chọn giữ bên mình.”<br\/><br\/>Hãy để những thiết kế mang linh khí của Venus trở thành điểm tựa tinh thần, để yêu thương và may mắn khẽ đến theo cách tự nhiên nhất.<br\/><br\/>Gratia dành riêng cho những cô gái tin rằng: yêu thương luôn tìm đường đến với mình, may mắn luôn dừng lại đúng lúc mình cần, và vẻ đẹp của mình là một phép màu dịu dàng.<\/p>","link_url":"","link_text":"","link_style":"link"}},"item_CmjNzj":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/5_20715a1f-8cf1-4404-bb43-26c69f0e400b.jpg","column_size":"3","title":"","heading_tag":"h4","content":"","link_url":"","link_text":"","link_style":"link"}},"item_mRzTGh":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/4_0c8dc37c-13d9-473f-979c-bb5c7dcbaae5.jpg","column_size":"3","title":"","heading_tag":"h4","content":"","link_url":"","link_text":"","link_style":"link"}}},"block_order":["item_D97BzA","item_CmjNzj","item_mRzTGh"],"name":"Multi-column","settings":{"full_width":true,"stack_on_mobile":false,"gap":"small","text_alignment":"start","subheading":"","title":"","content":"","background":"","background_gradient":"","text_color":""}},"image_link_blocks_HiQhRg":{"type":"image-link-blocks","blocks":{"item_g4dDF7":{"type":"item","settings":{"image":"shopify:\/\/shop_i